        "sitemap generator api",
        "xml sitemap generator api",
        "sitemap generator",
        "xml sitemap"
    ],
    "homepage": "https://apiverve.com/marketplace/sitemapgenerator?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/sitemapgenerator",
        "source": "https://github.com/apiverve/sitemapgenerator-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
